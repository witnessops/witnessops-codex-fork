{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DynamicToolCallOutputContentItem": {
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "enum": [
                "inputText"
              ],
              "title": "InputTextDynamicToolCallOutputContentItemType",
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "title": "InputTextDynamicToolCallOutputContentItem",
          "type": "object"
        },
        {
          "properties": {
            "imageUrl": {
              "type": "string"
            },
            "type": {
              "enum": [
                "inputImage"
              ],
              "title": "InputImageDynamicToolCallOutputContentItemType",
              "type": "string"
            }
          },
          "required": [
            "imageUrl",
            "type"
          ],
          "title": "InputImageDynamicToolCallOutputContentItem",
          "type": "object"
        },
        {
          "properties": {
            "audioUrl": {
              "type": "string"
            },
            "type": {
              "enum": [
                "inputAudio"
              ],
              "title": "InputAudioDynamicToolCallOutputContentItemType",
              "type": "string"
            }
          },
          "required": [
            "audioUrl",
            "type"
          ],
          "title": "InputAudioDynamicToolCallOutputContentItem",
          "type": "object"
        }
      ]
    },
    "DynamicToolCallResponse": {
      "properties": {
        "cleanupComplete": {
          "description": "After cancellation, true acknowledges that all callback effects and child processes have stopped and cleanup/reaping has completed. Missing/false, malformed responses and transport errors do not release turn teardown.",
          "type": "boolean"
        },
        "contentItems": {
          "items": {
            "$ref": "#/definitions/DynamicToolCallOutputContentItem"
          },
          "type": "array"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "contentItems",
        "success"
      ],
      "type": "object"
    },
    "DynamicToolCleanupIdentity": {
      "properties": {
        "callId": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "requestId": {
          "$ref": "#/definitions/RequestId"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "callId",
        "capability",
        "requestId",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "type": "integer"
        }
      ]
    }
  },
  "properties": {
    "identity": {
      "$ref": "#/definitions/DynamicToolCleanupIdentity"
    },
    "response": {
      "allOf": [
        {
          "$ref": "#/definitions/DynamicToolCallResponse"
        }
      ],
      "description": "Original result, retained by the owner after verified cleanup. This RPC never executes work."
    }
  },
  "required": [
    "identity",
    "response"
  ],
  "title": "DynamicToolCleanupAckParams",
  "type": "object"
}